# Environment configuration
ENVIRONMENT=development

# Logging
LOG_LEVEL=INFO
LOG_FILE=
LOG_MAX_SIZE=10485760
LOG_BACKUP_COUNT=5

# Optional dashboard locations (defaults: data/sample and reports/web)
TRADINGBOT_DATA_DIR=
TRADINGBOT_RUNS_DIR=

# NOTE: Strategy/backtest parameters are CLI flags (or the dashboard form),
# not environment variables. Never put real API keys or secrets in this file:
# this project performs research and historical backtesting ONLY — no exchange
# connectivity exists.
