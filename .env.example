# Environment configuration
ENVIRONMENT=development

# Logging
LOG_LEVEL=INFO
LOG_FILE=
LOG_MAX_SIZE=10485760
LOG_BACKUP_COUNT=5

# Data provider
CSV_FILE_PATH=data/sample/sample_sinus_1h.csv
DEFAULT_SYMBOL=BTCUSDT
DEFAULT_TIMEFRAME=1h

# Strategy (detection values are REFERENCE INTERPRETATIONS, see docs/strategy.md)
SWING_LEFT_WINDOW=3
SWING_RIGHT_WINDOW=3
SWING_MIN_SEPARATION=1
MIN_DISTANCE=0.0
TARGET_MODE=high_low_reach
TARGET_PROJECTION=c_anchored_ratio
INVALIDATION_RULE=reference
MAX_CANDLES_ACTIVE=200
ALLOW_OVERLAPPING=true
DIRECTION=both

# Backtesting / cost model (informational only; defaults are zero)
INITIAL_CAPITAL=100000.0
TRANSACTION_COST=0.0
SLIPPAGE=0.0
SPREAD=0.0
MAX_DRAWDOWN=0.2
MAX_POSITION_SIZE=1.0
ENABLE_LOGGING=true

# Output paths
REPORTS_DIR=reports
CHARTS_DIR=charts

# NOTE: Never put real API keys or secrets in this file. This project performs
# research and historical backtesting ONLY — no exchange connectivity exists.
